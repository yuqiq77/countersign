# API
COUNTERSIGN_ENV=local
COUNTERSIGN_DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5435/countersign
COUNTERSIGN_TEMPORAL_ADDRESS=localhost:7233
COUNTERSIGN_TEMPORAL_NAMESPACE=default
COUNTERSIGN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Model provider. Keep fake for model-free local runs; use anthropic for live calls.
COUNTERSIGN_MODEL_PROVIDER=fake
COUNTERSIGN_MODEL_ID=claude-opus-5
