# API
COUNTERSIGN_ENV=local
COUNTERSIGN_DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5435/countersign
COUNTERSIGN_TEMPORAL_ADDRESS=localhost:7233
COUNTERSIGN_TEMPORAL_NAMESPACE=default
COUNTERSIGN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Model provider. Keep fake for model-free local runs; use anthropic for live calls.
COUNTERSIGN_MODEL_PROVIDER=fake
COUNTERSIGN_MODEL_ID=claude-opus-5
# ANTHROPIC_API_KEY=
# A blank ANTHROPIC_BASE_URL is treated as unset.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Operator salary bands (annual gross, one currency): set all three or none.
# Blank counts as unset. With none set the worker logs a warning and uses the
# generic USD example, so postings in other currencies get compensation UNKNOWN.
# A partial or malformed set stops the worker at startup. Real values stay in .env.
# COUNTERSIGN_SALARY_CURRENCY=EUR
# COUNTERSIGN_SALARY_ACCEPTABLE_MIN=
# COUNTERSIGN_SALARY_ATTRACTIVE_MIN=

# Operator profile (gitignored Markdown the evaluator judges fit against).
# Unset or blank: the prompt states "Candidate profile: NOT PROVIDED". Set:
# the file must exist and be non-empty or the worker refuses to start. Use a
# path relative to the repository root under config/operator/; Compose mounts
# that directory read-only at the same relative location in the worker.
# COUNTERSIGN_OPERATOR_PROFILE_PATH=config/operator/profile.md

# Official company hosts (gitignored JSON the reader classifies as
# OFFICIAL_COMPANY on an exact hostname match; shape and synthetic example
# in config/official-hosts.example.json). Unset or blank: no mapping. Set:
# the file must exist and validate or the worker refuses to start. Same
# path convention as the profile.
# COUNTERSIGN_OFFICIAL_HOSTS_PATH=config/operator/official-hosts.json

# Optional headless Chromium (or chrome-headless-shell) for the page reader's
# RENDER action on host runs (pytest, a local worker). Unset: rendering is
# reported unavailable and the reader works from static HTML and JSON-LD.
# Playwright controls the binary to record real response metadata; a
# Playwright cache binary works. Compose ignores this value: the image
# installs its own Chromium and sets the path itself.
# COUNTERSIGN_CHROMIUM_PATH=
